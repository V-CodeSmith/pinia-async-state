{
  "name": "pinia-async-state",
  "version": "0.1.0",
  "description": "A tiny Pinia plugin that automatically tracks loading and error state for every async action.",
  "keywords": [
    "pinia",
    "vue",
    "plugin",
    "loading",
    "async",
    "typescript",
    "composition-api",
    "state-management"
  ],
  "license": "MIT",
  "author": "V-CodeSmith",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "pinia": "^2.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "pinia": "^2.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vue": "^3.4.0"
  }
}
