{
  "name": "pinia-async-state",
  "version": "0.2.0",
  "description": "A tiny Pinia plugin that tracks loading and error state for every async action — per store and per action, with zero boilerplate.",
  "keywords": [
    "pinia",
    "vue",
    "nuxt",
    "plugin",
    "loading",
    "async",
    "error-handling",
    "loading-state",
    "typescript",
    "composition-api",
    "state-management"
  ],
  "license": "MIT",
  "author": "V-CodeSmith",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V-CodeSmith/pinia-async-state.git"
  },
  "homepage": "https://github.com/V-CodeSmith/pinia-async-state#readme",
  "bugs": {
    "url": "https://github.com/V-CodeSmith/pinia-async-state/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "pinia": "^2.1.7 || ^3.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "pinia": "^2.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vue": "^3.4.0"
  }
}
